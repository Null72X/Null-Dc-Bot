{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "preserve",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@null-bot/config": [
        "../../packages/config/src/index.ts"
      ],
      "@null-bot/database": [
        "../../packages/database/src/index.ts"
      ],
      "@null-bot/logger": [
        "../../packages/logger/src/index.ts"
      ],
      "@null-bot/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@null-bot/types": [
        "../../packages/types/src/index.ts"
      ]
    },
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "allowJs": true,
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
