# DISCORD BOT CONFIGURATION
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback/discord

# DATABASE CONFIGURATION
MONGODB_URI=mongodb://127.0.0.1:27017/nullbot
DATABASE_NAME=nullbot

# DASHBOARD CONFIGURATION
DASHBOARD_URL=http://localhost:3000
PORT=3000
SESSION_SECRET=super_secret_random_string_at_least_32_chars_long
ENCRYPTION_KEY=super_secret_encryption_key_32_bytes!
NODE_ENV=development

# BOT IDENTITY CUSTOMIZATION
BOT_NAME=NULL
BOT_AVATAR_URL=https://cdn.discordapp.com/embed/avatars/0.png
DEFAULT_EMBED_COLOR=#5865F2
SUPPORT_SERVER_URL=https://discord.gg/nullbot
WEBSITE_URL=http://localhost:3000
